# Copy this file to .env.local and fill in what you need.

# Required: Postgres connection string. In production (Render) this is set
# automatically from the managed Postgres instance. For local dev, point it
# at any Postgres database (e.g. a free one on Render, or a local instance).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Set this to "disable" only if your Postgres provider doesn't support/need
# SSL (e.g. some local setups). Leave unset for Render and most hosted DBs.
# PGSSL=disable

# Admin panel (single-vendor demo auth — see README before going to production)
ADMIN_PASSWORD=admin123
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string

# Optional: set this to upgrade the chatbot from the built-in rule-based
# engine to real Claude tool-calling. Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5
